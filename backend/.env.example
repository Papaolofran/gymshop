# =============================================
# GYMSHOP BACKEND - VARIABLES DE ENTORNO
# =============================================
# Copia este archivo como .env y completa con tus credenciales reales.
# NUNCA subas el .env real a Git.

# --- SERVIDOR ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# URL donde corre el frontend (cambiar en producción)
FRONTEND_URL=http://localhost:5173

# --- SUPABASE ---
# Ir a: supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=tu-anon-public-key
SUPABASE_SERVICE_KEY=tu-service-role-key

# --- MERCADO PAGO ---
# Ir a: mercadopago.com.ar/developers/panel → Credenciales
# Usar credenciales TEST para desarrollo, PROD para producción
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# --- WEBHOOKS MERCADO PAGO ---
# URL pública que recibirá notificaciones de pago de MP
# En desarrollo: usar ngrok o similar
MP_WEBHOOK_URL=https://tu-dominio.com/api/orders/webhook
