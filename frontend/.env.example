# =============================================
# GYMSHOP FRONTEND - VARIABLES DE ENTORNO (VITE)
# =============================================
# Copia este archivo como .env y completa con tus credenciales reales.
# NUNCA subas el .env real a Git.
# ⚠️  En Vite todas las variables DEBEN empezar con VITE_ para ser
#     accesibles en el navegador vía import.meta.env.VITE_*

# --- SUPABASE ---
# Ir a: supabase.com → tu proyecto → Settings → API
# Usar solo la anon/public key. NUNCA la service_role en el frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# --- BACKEND API ---
# URL base del servidor Express (backend)
VITE_API_URL=http://localhost:3000

# --- FRONTEND URL ---
# URL pública del frontend (usada en redirecciones de auth y MercadoPago)
VITE_FRONTEND_URL=http://localhost:5173
